DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=Admin@123

# Database
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/jobconnect
TEST_DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/jobconnect_test
READ_REPLICA_DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/jobconnect

# JWT Settings
JWT_SECRET_KEY=your-secret-key-here
JWT_REFRESH_SECRET_KEY=your_jwt_refresh_secret_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Paystack
PAYSTACK_SECRET_KEY=your-paystack-secret-key
PAYSTACK_PUBLIC_KEY=your-paystack-public-key
PAYSTACK_BASE_URL=https://api.paystack.co

# NIMC
NIMC_API_KEY=your-nimc-api-key
NIMC_API_URL=your-nimc-api-url

# Mailtrap
MAIL_USERNAME=your_email@example.com
MAIL_PASSWORD=your_email_password
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_STARTTLS=True
MAIL_FROM=your_email@example.com
MAIL_SENDER_NAME="Your Name"

# Twilio
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_NUMBER=your-twilio-phone-number

# File Upload
UPLOAD_DIR=storage/uploads  # Relative to project root
MAX_UPLOAD_SIZE=5242880  # 5MB

# KYC
UVERIFY_API_KEY=your-uverify-api-key
UVERIFY_API_URL=https://api.uverify.com/v1

# Redis
REDIS_URL=redis://localhost:6379/0

# CORS
ALLOWED_ORIGINS=["http://localhost:5173", "*"]

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# App Settings
DEBUG=True
API_BASE_URL=http://localhost:8000
API_V1_PREFIX=/api/v1
PROJECT_NAME=JobConnect
VERSION=1.0.0
SYSTEM_USER_ID=1
TESTING=False

# SSL
ENABLE_SSL=False
SSL_CERT_PATH=""
SSL_KEY_PATH=""


